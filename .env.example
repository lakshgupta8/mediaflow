# Copy this file to .env.local and fill in the blanks. Never commit .env.local.

# --- TMDB (movie and series data) -------------------------------------------
# https://www.themoviedb.org/settings/api  ->  "API Read Access Token"
NEXT_PUBLIC_TMDB_ACCESS_TOKEN=

# --- Appwrite (accounts, database, avatar storage) --------------------------
# https://cloud.appwrite.io  ->  your project  ->  Settings
# Use the endpoint shown there; it may be regional (e.g. https://fra.cloud.appwrite.io/v1).
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Optional overrides. The defaults match scripts/setup-appwrite.ts.
# NEXT_PUBLIC_APPWRITE_DATABASE_ID=mediaflow
# NEXT_PUBLIC_APPWRITE_BUCKET_ID=avatars

# Server-only API key. Never prefix it with NEXT_PUBLIC_.
# Used by the API routes (account deletion, email checks) and by `bun run setup:appwrite`.
# Scopes: users.read, users.write, databases.read, databases.write, tables.read, tables.write,
#         columns.read, columns.write, indexes.read, indexes.write, rows.read, rows.write,
#         buckets.read, buckets.write, files.read, files.write
APPWRITE_API_KEY=
